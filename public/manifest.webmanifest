{
  "id": "./",
  "name": "BrainBoro: Test Prep & Homework Help",
  "short_name": "BrainBoro",
  "description": "SHSAT, TACHS, Regents & SAT prep, a homework planner that connects to your school, and an AI tutor.",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f5f4fa",
  "theme_color": "#6d4aff",
  "categories": ["education", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Snap & Answer", "short_name": "Answer", "url": "./#/answer", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Planner", "url": "./#/planner", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Daily Brain Blast", "short_name": "Blast", "url": "./#/daily", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Ask Boro", "url": "./#/tutor", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "image", "accept": ["image/*"] }] }
  }
}
